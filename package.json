{
  "name": "@yiyunet/dsh-dingtalk-connector",
  "version": "1.0.1",
  "description": "DSH 插件：读写钉钉 AI 表格（多维表 / aitable），并提供「钉钉文档」设置面板与定时导出。包装钉钉官方 dws CLI。 Read and write DingTalk AI Tables from DeepSeek Harness, with a settings panel and scheduled CSV export.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dingtalk",
    "dingtalk-workspace-cli",
    "dws",
    "aitable",
    "多维表",
    "ai-table",
    "csv-export",
    "scheduled-export",
    "automation",
    "rpa",
    "mcp",
    "agent-tools"
  ],
  "author": {
    "name": "yiyunet",
    "url": "https://github.com/yiyunet"
  },
  "contributors": [
    {
      "name": "yiyunet",
      "url": "https://github.com/yiyunet"
    }
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiyunet/dsh-dingtalk-connector.git"
  },
  "homepage": "https://github.com/yiyunet/dsh-dingtalk-connector#readme",
  "bugs": {
    "url": "https://github.com/yiyunet/dsh-dingtalk-connector/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-dingtalk-connector": "bin/dsh-dingtalk-connector.mjs"
  },
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "bin",
    "cordis.patch.yml",
    "lib",
    "plugin-src",
    "scripts",
    "LICENSE",
    "CHANGELOG.md",
    "CONTEXT.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.1 || 0.1.5-alpha.1",
      "dshReleases": {
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible",
        "0.1.5-alpha.1": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build.mjs --host-only",
    "build:client": "node scripts/build.mjs --client-only",
    "test": "node --test test/*.test.mjs",
    "verify": "node scripts/verify-package.mjs",
    "inspect": "node scripts/inspect-bundle.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm run check",
    "check": "npm run build && npm test && npm run verify"
  },
  "optionalDependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  },
  "directories": {
    "lib": "lib",
    "test": "test",
    "doc": "docs"
  }
}
